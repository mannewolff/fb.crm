{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    // Ein referenziertes Projekt darf die Ausgabe nicht ganz abschalten (TS6310). Es
    // schreibt deshalb nur Deklarationen, und die landen unter node_modules/.tmp.
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/node-types",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts"]
}
