{
  "codeHost": "github",
  "issueTracker": "toolbox",
  "buildChecks": [
    {
      "cmd": "mvn verify -DskipITs -Dskip.frontend=true -Djacoco.skip=true",
      "areas": [
        "backend"
      ]
    },
    {
      "cmd": "mvn verify",
      "areas": [
        "backend",
        "doku"
      ],
      "stage": "push"
    },
    {
      "cmd": "npm --prefix frontend run build",
      "areas": [
        "frontend"
      ]
    },
    {
      "cmd": "npm --prefix frontend run lint",
      "areas": [
        "frontend"
      ]
    },
    {
      "cmd": "npm --prefix frontend run test:coverage",
      "areas": [
        "frontend"
      ]
    },
    {
      "cmd": "node -e \"JSON.parse(require('fs').readFileSync('.claude/workflow.config.json','utf8'))\"",
      "areas": [
        "betrieb"
      ]
    }
  ],
  "mutationCommand": "mvn -Ppit -Dskip.frontend=true test",
  "mainBranch": "main",
  "productionBranch": "production",
  "reviewScope": "diff",
  "triggers": {
    "go": "GO",
    "push": "push main",
    "merge": "merge production"
  },
  "local": {
    "issuesDir": "issues"
  },
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "in_progress": "In progress",
    "in_review": "In review",
    "done": "Done"
  },
  "findings": {
    "threshold": 15
  },
  "checkAreas": {
    "backend": [
      "pom.xml",
      "mvnw",
      "mvnw.cmd",
      ".mvn/**",
      "src/**",
      "config/**",
      "sonar-project.properties",
      ".github/**"
    ],
    "frontend": [
      "frontend/**",
      "scripts/**",
      "docs/**",
      "README.md"
    ],
    "doku": [
      "**/*.md",
      "docs/**",
      "specs/**",
      "*.pdf"
    ],
    "betrieb": [
      ".claude/**",
      ".githooks/**",
      ".gitignore",
      "install.mjs",
      "Caddyfile",
      "Dockerfile",
      "docker-compose*.yml",
      ".env.example"
    ]
  },
  "stufen": {
    "schwer": {
      "modell": "claude-opus-5-5",
      "effort": "high"
    },
    "mittel": {
      "modell": "claude-opus-5-5",
      "effort": "medium"
    },
    "leicht": {
      "modell": "claude-opus-5-5",
      "effort": "low"
    }
  },
  "reviewCommand": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\"",
  "formatFixCommand": "mvn spotless:apply",
  "installCommand": "npm --prefix frontend ci --cache \"${TMPDIR:-/tmp}/npm-cache\" --no-audit --no-fund",
  "github": {
    "projectNumber": 13
  },
  "reviewStages": {
    "requirement": {
      "reviewer": 2,
      "roles": [
        "form-beobachtbarkeit",
        "abgrenzung"
      ]
    },
    "plan": {
      "reviewer": 1,
      "roles": [
        "architektur-bestand"
      ]
    },
    "issue": {
      "reviewer": 1,
      "roles": [
        "pruefbarkeit"
      ]
    }
  },
  "checkRun": {
    "checkMin": 60
  },
  "night": {
    "chain": {
      "label": "kit:night",
      "planMin": 30,
      "packagesMin": 75,
      "reviewMin": 60,
      "coverageMin": 20,
      "implementationMin": 240,
      "costUsd": 50,
      "correctionRounds": 2
    },
    "models": [
      "claude-opus-5-5",
      "claude-sonnet-5",
      "claude-fable-5-1"
    ],
    "tiers": {
      "hard": {
        "model": "claude-opus-5-5",
        "effort": "high"
      },
      "medium": {
        "model": "claude-opus-5-5",
        "effort": "medium"
      },
      "easy": {
        "model": "claude-opus-5-5",
        "effort": "low"
      }
    }
  },
  "toolbox": {
    "host": "https://kanban.mwolff.org",
    "tokenFile": ".claude/toolbox.cli/tbx.token"
  },
  "issueReview": {
    "rounds": 1,
    "requiredBeforeReady": false,
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5-5"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5-1"
      },
      {
        "name": "gpt-sol",
        "kind": "command",
        "model": "gpt-5.6-sol",
        "command": "codex exec --model gpt-5.6-sol -c model_reasoning_effort=\"high\""
      },
      {
        "name": "gpt-astra",
        "kind": "command",
        "model": "gpt-6-astra",
        "command": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\""
      }
    ],
    "pairs": {
      "opus": [
        "fable",
        "gpt-astra"
      ],
      "sonnet": [
        "fable",
        "gpt-sol"
      ],
      "fable": [
        "opus",
        "gpt-astra"
      ]
    },
    "statusLabels": true
  },
  "pushCheck": {
    "location": "buildDienst",
    "branch": "kit-pruefung"
  },
  "scenariosFrom": 303
}
