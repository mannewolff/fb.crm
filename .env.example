# fb.crm — Vorlage fuer die .env
#
#   cp .env.example .env
#
# Die Datei fuehrt jede Variable, die docker-compose.yml oder docker-compose.prod.yml liest —
# nicht mehr und nicht weniger (EnvExampleTest). Sie traegt nur Platzhalter, keine echten Werte
# (EnvExampleSecretTest): Diese Vorlage liegt im Repository und ist damit oeffentlich.
#
# Ein leerer Wert heisst: Es gilt der Default aus docker-compose.yml. Fuer den lokalen Betrieb
# genuegt das fast ueberall — gesetzt werden muss nur FBCRM_BOOTSTRAP_ADMIN_TOKEN, sonst laesst
# sich die Instanz nicht einrichten. Im Produktionsbetrieb (docker-compose.prod.yml) sind
# FBCRM_SESSION_SECRET, FBCRM_BASE_URL und FBCRM_DOMAIN Pflicht; ohne sie bricht schon
# `docker compose config` ab.

# --- Betrieb ------------------------------------------------------------------------------------

# true erlaubt den Start mit dem voreingestellten Session-Secret und warnt dabei; false verweigert
# ihn. Das Produktions-Overlay setzt fest false und liest diesen Wert nicht.
FBCRM_DEV_MODE=true

# Oeffentliche Adresse der Instanz; aus ihr entsteht der Link in der Passwort-Reset-Mail.
FBCRM_BASE_URL=https://localhost

# Host, unter dem Caddy (lokal) bzw. Traefik (Produktion) die Anwendung ausliefert.
FBCRM_DOMAIN=localhost

# Kontaktadresse fuer Let's Encrypt, sobald Caddy ein echtes Zertifikat holt (nicht bei localhost).
FBCRM_ACME_EMAIL=admin@localhost

# --- Anmeldung ----------------------------------------------------------------------------------

# Signaturgeheimnis der Session-Tokens, mindestens 32 Byte. Leer = Dev-Default (nur mit
# FBCRM_DEV_MODE=true). Erzeugen mit: openssl rand -base64 48
FBCRM_SESSION_SECRET=

# Session-Cookie nur ueber HTTPS ausliefern. Nur fuer reines HTTP ohne Caddy auf false setzen.
FBCRM_SESSION_COOKIE_SECURE=true

# Einmal-Schluessel fuer die Einrichtung des ersten Kontos auf /einrichten. Leer = Einrichtung
# abgeschaltet. Wirkt nur, solange kein Konto existiert. Erzeugen mit: openssl rand -hex 24
FBCRM_BOOTSTRAP_ADMIN_TOKEN=

# Peer-Adressen, deren X-Forwarded-For die Anwendung glaubt, kommagetrennt (E9). Leer = es zaehlt
# die Adresse der Gegenstelle. Hinter Traefik dessen Adresse im Netz "web" eintragen — und nur
# dann, wenn Traefik eingehende X-Forwarded-*-Koepfe fremder Quellen verwirft (README).
FBCRM_TRUSTED_PROXIES=

# Administrativer Rueckweg (E6) — kein Schalter, sondern ein Handgriff: Wer sich bei der
# Einrichtung in seiner E-Mail-Adresse vertippt hat, loescht die Kontozeile; danach greift der
# Einmal-Schluessel wieder, und die Einrichtung laeuft erneut:
#
#   docker compose exec postgres psql -U fbcrm -d fbcrm -c "DELETE FROM account;"
#
# Das entfernt JEDES Konto. Nur auf einer frisch eingerichteten Instanz ausfuehren (README).

# --- Datenbank ----------------------------------------------------------------------------------

# Name, Nutzer und Passwort der PostgreSQL-Datenbank. Leer = fbcrm. Nach dem ersten Start
# liegen sie im Volume postgres_data; eine spaetere Aenderung hier greift dort nicht mehr.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Objektspeicher -----------------------------------------------------------------------------

# Zugang zum MinIO-Objektspeicher. Leer = fbcrm / fbcrm-minio.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Mail ---------------------------------------------------------------------------------------

# Ob die Anwendung Mails wirklich zustellt. false = Auftraege bleiben unzugestellt liegen.
FBCRM_MAIL_ENABLED=false

# Absenderadresse der Mails.
FBCRM_MAIL_FROM=no-reply@fbcrm.local

# SMTP-Server. Leer = mailpit:1025, der Auffangserver aus dem Profil dev-mail; fuer ihn
# FBCRM_SMTP_AUTH und FBCRM_SMTP_STARTTLS auf false setzen.
FBCRM_SMTP_HOST=
FBCRM_SMTP_PORT=

# Zugangsdaten des SMTP-Servers; leer, wenn er keine Anmeldung verlangt.
FBCRM_SMTP_USER=
FBCRM_SMTP_PASSWORD=

# Ob der SMTP-Server Anmeldung bzw. STARTTLS verlangt. Leer = true.
FBCRM_SMTP_AUTH=
FBCRM_SMTP_STARTTLS=

# --- Postausgangsfach ---------------------------------------------------------------------------

# Hintergrundzustellung der Seiteneffekte (E7). Leer = eingeschaltet, alle 5 s, hoechstens
# 8 Versuche, erledigte Auftraege 7 Tage aufbewahrt.
FBCRM_OUTBOX_ENABLED=
FBCRM_OUTBOX_POLL_INTERVAL_MS=
FBCRM_OUTBOX_MAX_ATTEMPTS=
FBCRM_OUTBOX_RETENTION_DAYS=
