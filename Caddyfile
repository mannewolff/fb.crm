# Caddy stellt fb.crm öffentlich bereit und terminiert TLS.
# Automatisches HTTPS mit HTTP->HTTPS-Redirect:
#   - Domain "localhost" (Default) -> lokale interne CA (self-signed)
#   - echte Domain (FBCRM_DOMAIN gesetzt) -> automatisch Let's-Encrypt-Zertifikat
{
	email {$FBCRM_ACME_EMAIL:admin@localhost}
}

{$FBCRM_DOMAIN:localhost} {
	encode gzip
	# X-Forwarded-For wird ersetzt, nicht angehaengt: Caddy haengt den Wert sonst hinten an,
	# und ein vom Client mitgeschickter Eintrag bliebe stehen. Eine Zaehlbremse liest zwar von
	# rechts und kaeme damit zurecht — aber diese zweite Linie im Proxy haelt die Umgehung auch
	# dann geschlossen, wenn spaeter trusted-proxy-count oder die Filterreihenfolge geaendert
	# wird, ohne dass es jemandem auffaellt.
	#
	# header_up ist eine Unteranweisung von reverse_proxy: Auf Ebene des Site-Blocks weist Caddy
	# den ganzen Caddyfile mit "unrecognized directive" ab und startet nicht (Issue #32).
	reverse_proxy fbcrm-api:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
